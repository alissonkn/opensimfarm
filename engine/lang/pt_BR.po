msgid ""
"That folder does not hold SimFarm's files\n"
"(MEGADATA.IDX and MEGADATA.EEA):\n"
"{0}"
msgstr ""
"Essa pasta não tem os arquivos do SimFarm\n"
"(MEGADATA.IDX e MEGADATA.EEA):\n"
"{0}"

