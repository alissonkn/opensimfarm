# Writes font_builtin.cpp: the fonts in src/third_party/fonts/*/*.ttf as byte arrays (see src/ui/ModernFont.cpp).
#   cmake -DOUT=<file> -DFILES="<a.ttf>;<b.ttf>" -P EmbedFont.cmake
set(body "// made by tools/EmbedFont.cmake from src/third_party/fonts - do not edit\nnamespace osf {\nstruct BuiltinFont { const char* file; const unsigned char* data; unsigned long size; };\n")
set(list "")
set(n 0)
foreach(f IN LISTS FILES)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    get_filename_component(name "${f}" NAME)
    string(APPEND body "static const unsigned char kFont${n}[] = {${hex}0};\n")
    string(APPEND list "    { \"${name}\", kFont${n}, ${size}ul },\n")
    math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
    string(APPEND body "extern const BuiltinFont kBuiltinFonts[] = { { \"\", nullptr, 0ul } };\nextern const int kBuiltinFontCount = 0;\n}\n")
else()
    string(APPEND body "extern const BuiltinFont kBuiltinFonts[] = {\n${list}};\nextern const int kBuiltinFontCount = ${n};\n}\n")
endif()
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
