# Writes music_builtin.cpp: the songs in engine/music/*.mid as byte arrays (see src/audio/Music.cpp).
#   cmake -DOUT=<file> -DFILES="<a.mid>;<b.mid>" -P EmbedMusic.cmake
set(body "// made by tools/EmbedMusic.cmake from engine/music/*.mid - do not edit\nnamespace osf {\nstruct BuiltinMusic { const char* file; const unsigned char* data; unsigned long size; };\n")
set(list "")
set(n 0)
foreach(f IN LISTS FILES)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    get_filename_component(name "${f}" NAME)
    string(APPEND body "static const unsigned char kMusic${n}[] = {${hex}0};\n")
    string(APPEND list "    { \"${name}\", kMusic${n}, ${size}ul },\n")
    math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
    string(APPEND body "extern const BuiltinMusic kBuiltinMusic[] = { { \"\", nullptr, 0ul } };\nextern const int kBuiltinMusicCount = 0;\n}\n")
else()
    string(APPEND body "extern const BuiltinMusic kBuiltinMusic[] = {\n${list}};\nextern const int kBuiltinMusicCount = ${n};\n}\n")
endif()
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
