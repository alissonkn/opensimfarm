# Writes lang_builtin.cpp: the dictionaries in engine/lang/*.po as byte arrays (see src/core/Lang.cpp).
#   cmake -DOUT=<file> -DFILES="<a.po>;<b.po>" -P EmbedLang.cmake
set(body "// made by tools/EmbedLang.cmake from engine/lang/*.po - do not edit\nnamespace osf {\nstruct BuiltinLang { const char* file; const unsigned char* data; unsigned long size; };\n")
set(list "")
set(n 0)
foreach(f IN LISTS FILES)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    get_filename_component(name "${f}" NAME)
    string(APPEND body "static const unsigned char kLang${n}[] = {${hex}0};\n")
    string(APPEND list "    { \"${name}\", kLang${n}, ${size}ul },\n")
    math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
    string(APPEND body "extern const BuiltinLang kBuiltinLangs[] = { { \"\", nullptr, 0ul } };\nextern const int kBuiltinLangCount = 0;\n}\n")
else()
    string(APPEND body "extern const BuiltinLang kBuiltinLangs[] = {\n${list}};\nextern const int kBuiltinLangCount = ${n};\n}\n")
endif()
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
